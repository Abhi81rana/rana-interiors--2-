# Copy to server/.env and fill in. Never commit the real .env file.
PORT=5000

# REQUIRED for the admin dashboard. Choose a long, unique password and a long random secret.
ADMIN_PASSWORD=
JWT_SECRET=

# Comma-separated list of websites allowed to call the API from a browser
# (only needed when the frontend is hosted on a different domain).
CLIENT_ORIGIN=http://localhost:5173

# Set to 1 when running behind a proxy/host such as Render, Railway, Nginx (for correct rate limiting).
# TRUST_PROXY=1
